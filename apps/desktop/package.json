{
  "name": "@kansoku/desktop",
  "version": "0.42.0",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "main": "dist-main/main.mjs",
  "scripts": {
    "build": "vite build -c vite.main.config.ts --configLoader runner && vite build -c vite.preload.config.ts",
    "build:native": "npx electron-sparkle-updater rebuild --electron-version 43.1.0 --arch arm64",
    "predev": "node scripts/ensureDevNative.mjs",
    "dev": "node scripts/dev.mjs",
    "generate-icon": "bash scripts/generate-icon.sh",
    "prepackage": "pnpm --filter @kansoku/web build && (test -f ../web/dist/index.html || (echo 'web/dist/index.html missing after build' && exit 1))",
    "package": "pnpm build && node scripts/stageSkills.mjs && node scripts/stageAgentKit.mjs && node scripts/buildCli.mjs && pnpm build:native && node scripts/stagePro.mjs && node scripts/packageApp.mjs",
    "prestart": "node scripts/ensureDevNative.mjs",
    "start": "electron .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "electron-sparkle-updater": "^0.3.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@electron/asar": "^4.3.0",
    "@kansoku/build-overlay": "workspace:*",
    "@kansoku/core": "workspace:*",
    "@kansoku/pro-api": "workspace:*",
    "@kansoku/shared": "workspace:*",
    "@types/node": "^26.5.0",
    "@vibeloft/telemetry-electron": "0.1.0",
    "electron": "44.2.0",
    "electron-builder": "^26.15.3",
    "electron-context-menu": "^5.0.0",
    "electron-ipc-decorator": "^1.0.2",
    "electron-window-state": "5.0.3",
    "esbuild": "^0.28.2",
    "reflect-metadata": "0.2.2",
    "tsdown": "^0.23.0",
    "typescript": "^5.9.3",
    "vite": "^8.2.2",
    "vitest": "^5.0.0",
    "zod-compiler": "^2.0.3"
  }
}
