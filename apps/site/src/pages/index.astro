---
import Boot from '../components/landing/Boot.astro';
import HeroEvidence from '../components/landing/HeroEvidence.astro';
import LiveDemo from '../components/landing/LiveDemo.astro';
import PricingOutro from '../components/landing/PricingOutro.astro';
import TerminalChrome from '../components/landing/TerminalChrome.astro';
import Base from '../layouts/Base.astro';
import { dmgAsset, fetchDesktopReleases, releaseVersion } from '../lib/releases';

const releases = await fetchDesktopReleases();
const latest = releases[0]!;
const version = releaseVersion(latest);
const dmg = dmgAsset(latest);
if (!dmg) throw new Error(`release ${latest.tag_name} has no dmg asset`);

const title = 'Kansoku（観測）— 能查账的 AI 看盘搭子 · macOS 本地看盘应用';
const description =
  '它说的每句话，你都能查：每个结论挂着完整证据链，归档后不许改口，事后按命中率记分。macOS 本地 AI 看盘应用。';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Kansoku',
  alternateName: '観測',
  description,
  operatingSystem: 'macOS',
  applicationCategory: 'FinanceApplication',
  softwareVersion: version,
  dateModified: latest.published_at,
  url: 'https://kansoku.trade',
  downloadUrl: dmg.browser_download_url,
  author: { '@type': 'Person', name: 'Innei', url: 'https://innei.in' },
  offers: [
    { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    { '@type': 'Offer', price: '9.9', priceCurrency: 'USD' },
  ],
};
---

<Base title={title} description={description}>
  <script is:inline type="application/ld+json" slot="head" set:html={JSON.stringify(schema)} />
  <TerminalChrome version={version}>
    <Boot version={version} />
    <HeroEvidence version={version} downloadUrl={dmg.browser_download_url} />
    <LiveDemo />
    <PricingOutro version={version} downloadUrl={dmg.browser_download_url} />
  </TerminalChrome>
</Base>

<script>
  import '../scripts/landing/main';
</script>
