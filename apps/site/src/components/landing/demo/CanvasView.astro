---
import Icon from '../../Icon.astro';
import { DEMO_CANVASES } from '../../../scripts/landing/replica/canvasDocs';
import CanvasPanel from './CanvasPanel.astro';
import '../../../styles/landing/canvas.css';

---

<div class="app-view app-view--stack" data-app-view="canvas" data-active="false">
  <header class="demo-canvas-header">
    <div class="demo-canvas-title">
      <span class="demo-canvas-title-icon"><Icon name="layout-dashboard" size={16} /></span>
      <div>
        <h3>画布</h3>
        <p>AI 拼出来的分析板 · {DEMO_CANVASES.length} 张</p>
      </div>
    </div>
  </header>

  <div class="demo-canvas-workspace">
    <aside class="demo-canvas-explorer">
      <div class="demo-canvas-explorer-head">
        <span>画布</span>
        <span>{DEMO_CANVASES.length}</span>
      </div>
      <div class="demo-canvas-list">
        {
          DEMO_CANVASES.map((canvas, i) => (
            <button
              type="button"
              class:list={['demo-canvas-row', { active: i === 0 }]}
              data-canvas-row
              data-index={i}
              aria-pressed={i === 0 ? 'true' : 'false'}
            >
              <span class="demo-canvas-row-title">{canvas.title}</span>
              <span class="demo-canvas-row-slug">{canvas.slug}</span>
            </button>
          ))
        }
      </div>
    </aside>

    <main class="demo-canvas-reader">
      {DEMO_CANVASES.map((canvas, i) => <CanvasPanel canvas={canvas} index={i} active={i === 0} />)}
    </main>
  </div>
</div>
