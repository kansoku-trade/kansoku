---
import { marked } from 'marked';
import Icon from '../../Icon.astro';
import { RESEARCH_DOCS } from '../../../scripts/landing/replica/researchDocs';
import '../../../styles/landing/research.css';

const stockCount = RESEARCH_DOCS.filter((doc) => doc.kind === 'stock').length;
const journalCount = RESEARCH_DOCS.length - stockCount;
const rendered = await Promise.all(RESEARCH_DOCS.map((doc) => marked.parse(doc.markdown)));
---

<div class="app-view app-view--stack" data-app-view="research" data-active="false">
  <header class="research-header">
    <div class="research-title">
      <span class="research-title-icon"><Icon name="library" size={17} /></span>
      <div>
        <h3>研究库</h3>
        <p>{stockCount} 篇股票档案 · {journalCount} 篇研究日志</p>
      </div>
    </div>
    <div class="research-controls">
      <div class="research-view-switch" role="group" aria-label="研究库视图" data-research-switch>
        <button type="button" data-kind="stock" aria-pressed="true">
          <Icon name="book-open" size={13} /> 股票档案
        </button>
        <button type="button" data-kind="journal" aria-pressed="false">
          <Icon name="file-text" size={13} /> 研究日志
        </button>
      </div>
      <button type="button" class="research-new"><Icon name="plus" size={13} /> 新建</button>
      <label class="research-search">
        <Icon name="search" size={13} />
        <input type="search" placeholder="搜索股票或正文" data-research-search />
      </label>
      <button type="button" class="research-refresh" aria-label="刷新研究资料">
        <Icon name="refresh-cw" size={13} />
      </button>
    </div>
  </header>

  <div class="research-workspace">
    <aside class="research-explorer">
      <div class="research-explorer-head">
        <span data-research-head>股票档案</span>
        <span data-research-count>{stockCount}</span>
      </div>
      <div class="research-document-list">
        {
          RESEARCH_DOCS.map((doc, i) => (
            <button
              type="button"
              class="research-document-row"
              data-research-row
              data-kind={doc.kind}
              data-index={i}
              aria-pressed={i === 0 ? 'true' : 'false'}
            >
              <span class="research-document-row-head">
                <span class="research-document-row-title">{doc.listTitle}</span>
                <span class="research-document-row-date">{doc.date.slice(5)}</span>
              </span>
              <span class="research-document-row-meta">
                {[doc.typeLabel, doc.symbols.join(' · ')].filter(Boolean).join(' · ')}
              </span>
              <span class="research-document-row-excerpt">{doc.excerpt}</span>
            </button>
          ))
        }
      </div>
    </aside>

    <main class="research-reader">
      {
        RESEARCH_DOCS.map((doc, i) => (
          <article
            class="research-reader-document"
            data-research-doc
            data-index={i}
            data-active={i === 0 ? 'true' : 'false'}
          >
            <header class="research-reader-head">
              <div class="research-reader-heading">
                <span class={`badge${doc.kind === 'stock' ? ' badge--accent' : ''}`}>
                  {doc.typeLabel}
                </span>
                <h4>{doc.title}</h4>
                <div class="research-reader-meta">
                  <code>{doc.path}</code>
                  <span>更新于 {doc.mtime}</span>
                </div>
              </div>
              {doc.symbols.length > 0 && (
                <span class="app-btn research-cockpit-link">
                  <Icon name="chart-candlestick" size={13} /> 打开驾驶舱
                </span>
              )}
            </header>
            <div class="research-reader-body" set:html={rendered[i]} />
          </article>
        ))
      }
    </main>

    <aside class="research-context" aria-label="关联研究资料">
      <div class="research-related-summary">
        <Icon name="chevron-down" size={13} />
        <span data-research-related>关联资料 · 1 个标的 · 2 条相关记录</span>
      </div>
      <section class="research-context-section">
        <h5>关联标的</h5>
        <div class="research-symbol-links" data-research-symbols>
          <span class="chip">NVDA</span>
        </div>
      </section>
      <section class="research-context-section research-assistant">
        <h5>研究库 AI</h5>
        <p class="research-assistant-hint">
          按当前档案增量更新，只补新事实、不覆盖你写过的判断；改动以 diff 形式给你过目再落盘。
        </p>
        <div class="research-assistant-actions">
          <span class="app-btn"><Icon name="refresh-cw" size={12} /> 增量更新</span>
          <span class="app-btn"><Icon name="git-compare" size={12} /> 查看 diff</span>
        </div>
        <span class="research-assistant-tag">PRO</span>
      </section>
    </aside>
  </div>
</div>
