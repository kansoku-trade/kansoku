---
import '../../styles/landing/tokens.css';
import '../../styles/landing/reveal.css';
import features from '../../data/features.json';
import { subscription } from '../../lib/pricing';

interface Props {
  version: string;
  downloadUrl: string;
}

const { version, downloadUrl } = Astro.props;
const proShorts = features.pro.map((f) => f.short).join('、');
---

<section class="outro">
  <div class="outro-scene" data-outro-scene data-mode="plain">
    <canvas class="outro-canvas" data-outro-canvas aria-hidden="true" layoutsubtree>
      <p class="outro-src" data-outro-src>有出处 · 不改口 · 有战绩</p>
    </canvas>
    <p class="outro-status">有出处 · 不改口 · 有战绩</p>
  </div>

  <div class="outro-panel" data-reveal>
    <div class="outro-copy">
      <h2>免费版就是完整的看盘工具。</h2>
      <p class="outro-sub">
        Pro 解锁{proShorts} ——
        <span class="outro-deal">
          <span class="outro-badge">{subscription.discountLabel}</span>
          <s class="mono outro-list">{subscription.listPriceLabel}</s>
          <span class="mono outro-amount">{subscription.priceLabel}</span>
        </span>
        或
        <span class="outro-deal">
          <s class="mono outro-list">{subscription.yearly.listPriceLabel}</s>
          <span class="mono outro-amount">{subscription.yearly.priceLabel}</span>
        </span>
        （{subscription.yearly.discountLabel} · {subscription.yearly.savingsLabel}） · {
          subscription.trialDays
        } 天试用
      </p>
    </div>
    <div class="outro-cta">
      <a class="btn" href={downloadUrl}>免费下载 <span class="ver">v{version}</span></a>
      <a class="btn btn-ghost" href="/pricing">免费版 vs Pro</a>
    </div>
  </div>
</section>

<style>
  .outro {
    max-width: 1120px;
    margin: 0 auto;
    padding: 64px 24px 48px;
  }

  .outro-scene {
    position: relative;
    height: 84px;
    max-width: 560px;
    margin: 0 auto 36px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .outro-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: none;
  }

  .outro-scene[data-mode='canvas'] .outro-canvas {
    display: block;
  }

  .outro-src,
  .outro-status {
    margin: 0;
    font-family: var(--mono);
    font-size: 13px;
    letter-spacing: 0.1em;
    color: var(--accent);
    white-space: nowrap;
  }

  .outro-src {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
  }

  .outro-scene[data-mode='canvas'] .outro-status {
    visibility: hidden;
  }

  @media (prefers-reduced-motion: no-preference) {
    html[data-tier='full'] .outro-particle-canvas,
    html[data-tier='lite'] .outro-particle-canvas {
      transition: opacity 400ms ease;
    }

    html[data-landing-live][data-tier='full'] .outro-status,
    html[data-landing-live][data-tier='lite'] .outro-status {
      transition: opacity 300ms ease;
    }
  }

  .outro-panel {
    border: 1px solid var(--border-strong);
    border-radius: 2px;
    background: var(--surface);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: 32px 36px;
    flex-wrap: wrap;
  }

  .outro-copy h2 {
    font-size: 22px;
    margin: 0 0 8px;
  }

  .outro-sub {
    margin: 0;
    color: var(--text-2);
    font-size: 13px;
    line-height: 1.7;
  }

  .outro-deal {
    display: inline-flex;
    align-items: baseline;
    gap: 6px;
    flex-wrap: wrap;
  }

  .outro-badge {
    display: inline-flex;
    align-items: center;
    padding: 1px 6px;
    border: 1px solid rgba(255, 176, 0, 0.45);
    background: rgba(255, 176, 0, 0.1);
    color: var(--accent);
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.06em;
  }

  .outro-list {
    color: var(--text-3);
    text-decoration: line-through;
    text-decoration-thickness: 1px;
  }

  .outro-amount {
    color: var(--accent);
  }

  .outro-cta {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }

  @media (max-width: 720px) {
    .outro-panel {
      padding: 26px 24px;
    }
  }
</style>
