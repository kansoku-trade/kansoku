---
import '../../styles/landing/tokens.css';
import '../../styles/landing/chrome.css';

import { NAV_LINKS } from '../../lib/nav';
import { TAPE_SYMBOLS } from '../../scripts/landing/tape';

interface Props {
  version: string;
}

const { version } = Astro.props;
---

<div class="terminal-chrome" data-landing-root>
  <div class="chrome-corner chrome-corner-tl" aria-hidden="true"></div>
  <div class="chrome-corner chrome-corner-tr" aria-hidden="true"></div>
  <div class="chrome-corner chrome-corner-bl" aria-hidden="true"></div>
  <div class="chrome-corner chrome-corner-br" aria-hidden="true"></div>
  <div class="chrome-scanlines" aria-hidden="true"></div>

  <header class="chrome-topbar">
    <div class="chrome-topbar-left">
      <a class="chrome-brand" href="/" transition:name="brand">KANSOKU <b>観測</b></a>
      <span class="chrome-version">v{version}</span>
      <span class="chrome-et">ET</span>
      <time class="chrome-clock" data-chrome-clock>--:--:--</time>
      <span class="chrome-session">
        <span class="chrome-session-dot" data-chrome-session-dot aria-hidden="true"></span>
        <span data-chrome-session-text>CLOSED</span>
      </span>
    </div>
    <span class="chrome-spacer"></span>
    <div class="chrome-tape" data-chrome-tape>
      {
        TAPE_SYMBOLS.map(({ symbol }) => (
          <span class="chrome-tape-item" data-tape-symbol={symbol}>
            <span class="chrome-tape-sym">{symbol}</span>
            <span class="chrome-tape-last" data-tape-last>
              --
            </span>
            <span class="chrome-tape-chg" data-tape-chg>
              --
            </span>
          </span>
        ))
      }
      <span class="chrome-tape-delay">Delayed 15m</span>
    </div>
    <nav class="chrome-nav">
      {
        NAV_LINKS.map((link) => (
          <a
            href={link.href}
            transition:name={`nav-${link.key}`}
            target={link.external ? '_blank' : undefined}
            rel={link.external ? 'noreferrer' : undefined}
          >
            {link.label}
          </a>
        ))
      }
    </nav>
  </header>

  <div class="chrome-body">
    <slot />
  </div>
</div>

<script>
  import { initTerminalChrome } from '../../scripts/landing/chrome';
  import { onPageLive } from '../../scripts/landing/lifecycle';

  onPageLive(initTerminalChrome);
</script>
