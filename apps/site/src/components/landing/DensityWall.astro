---
import '../../styles/landing/tokens.css';
import '../../styles/landing/reveal.css';
import '../../styles/landing/density.css';
import { buildCandles } from '../../scripts/landing/kline';

const substrate = [
  '多周期 K 线（5m/15m/1h）实时刷新，均线、MACD、形态标注、价位线',
  '画线工具：趋势线、多段线、水平线、矩形、斐波那契，带样式预设',
  'SEPA 仪表盘：Minervini 趋势模板 8 条逐项打钩，自动给出结论',
  '盘中看板与历史复盘自动切换，判断与结果追踪、历史命中率',
  '美股为主，港股与 A 股已接入，交易时段按各自市场处理',
  '标签页、⌘K 命令面板、实时推送、Sparkle 自动更新',
];

const locals = [
  { tag: '✓ 本地拉取', body: '行情和账户数据从你自己的长桥账户拉，不经过任何中间服务器。' },
  { tag: '✓ 本地实算', body: '均线、MACD、RS、趋势模板、背离全部在本机 TypeScript 实算。' },
  { tag: '✓ 本地存 key', body: 'AI key 加密存本地 SQLite；用什么模型、花了多少钱，都在你自己的账上。' },
  { tag: '✓ 本地落盘', body: '结论和图表快照落成本地 markdown / JSON，可审计、可迁移。' },
];

const screenshots = [
  { src: '/landing/app-home.webp', width: 1600, height: 923, alt: '盘面看板', caption: '盘面看板 · 盘前汇总' },
  {
    src: '/landing/app-cockpit.webp',
    width: 1600,
    height: 1000,
    alt: '个股驾驶舱',
    caption: '个股驾驶舱 · 多周期研判',
  },
  {
    src: '/landing/app-chat.webp',
    width: 1600,
    height: 1000,
    alt: '追问对话',
    caption: '追问对话 · 画线联动',
  },
  {
    src: '/landing/app-research.webp',
    width: 1600,
    height: 1000,
    alt: '研究库',
    caption: '研究库 · 判断与结果追踪',
  },
  {
    src: '/landing/app-sepa.webp',
    width: 1600,
    height: 1000,
    alt: 'SEPA 仪表盘',
    caption: 'SEPA 仪表盘 · 趋势模板 8 条',
  },
  {
    src: '/landing/app-settings.webp',
    width: 1600,
    height: 1000,
    alt: 'AI 设置',
    caption: 'AI 设置 · key 本地加密存储',
  },
];

const KLINE_W = 240;
const KLINE_H = 108;
const klineCandles = buildCandles(26, { seed: 20260728, start: 180, volatility: 4.4 });
const klineHigh = Math.max(...klineCandles.map((c) => c.high));
const klineLow = Math.min(...klineCandles.map((c) => c.low));
const klineRange = klineHigh - klineLow || 1;
const klineSlot = KLINE_W / klineCandles.length;
const yOf = (value: number) => KLINE_H - ((value - klineLow) / klineRange) * KLINE_H;

const quoteStrip: { symbol: string; price: string; change: string; tone: 'up' | 'down' | 'neutral' }[] = [
  { symbol: 'NVDA.US', price: '184.22', change: '+1.83%', tone: 'up' },
  { symbol: 'MU.US', price: '241.06', change: '−0.94%', tone: 'down' },
  { symbol: 'SMH.US', price: '348.11', change: '+0.31%', tone: 'neutral' },
  { symbol: '700.HK', price: '412.60', change: '+0.62%', tone: 'up' },
  { symbol: '600519.SH', price: '1488.00', change: '−0.18%', tone: 'down' },
];
---

<section class="density-wall">
  <div class="density-copy">
    <h2>AI 之下，是一套完整的本地看盘工具。</h2>
    <ul class="density-points">
      {substrate.map((line) => <li>{line}</li>)}
    </ul>
    <p class="density-locals-lead">数据和算法都在你手上——所以每一步都查得到：</p>
    <dl class="density-locals">
      {
        locals.map((l) => (
          <>
            <dt>{l.tag}</dt>
            <dd>{l.body}</dd>
          </>
        ))
      }
    </dl>
  </div>

  <div class="density-scene" data-density-scene>
    <div class="density-grid">
      {
        screenshots.map((shot) => (
          <figure class="density-tile" data-reveal>
            <img
              src={shot.src}
              width={shot.width}
              height={shot.height}
              alt={shot.alt}
              loading="lazy"
            />
            <figcaption>{shot.caption}</figcaption>
          </figure>
        ))
      }

      <figure class="density-tile density-tile--synthetic" data-reveal>
        <svg
          class="density-kline"
          viewBox={`0 0 ${KLINE_W} ${KLINE_H}`}
          preserveAspectRatio="none"
          aria-hidden="true"
        >
          {
            klineCandles.map((c, i) => {
              const x = i * klineSlot + klineSlot * 0.5;
              const bodyTop = yOf(Math.max(c.open, c.close));
              const bodyHeight = Math.max(1, Math.abs(yOf(c.open) - yOf(c.close)));
              const tone = c.up ? 'var(--up)' : 'var(--down)';
              return (
                <>
                  <line
                    x1={x}
                    y1={yOf(c.high)}
                    x2={x}
                    y2={yOf(c.low)}
                    stroke={tone}
                    stroke-width="1"
                    opacity="0.5"
                  />
                  <rect
                    x={x - klineSlot * 0.28}
                    y={bodyTop}
                    width={klineSlot * 0.56}
                    height={bodyHeight}
                    fill={tone}
                    opacity="0.85"
                  />
                </>
              );
            })
          }
        </svg>
        <figcaption>多周期 K 线 · 本地实算</figcaption>
      </figure>

      <figure class="density-tile density-tile--synthetic" data-reveal>
        <ul class="density-quotes">
          {
            quoteStrip.map((q) => (
              <li>
                <span class="density-quote-sym">{q.symbol}</span>
                <span class="density-quote-price">{q.price}</span>
                <span class="density-quote-change" data-tone={q.tone}>
                  {q.change}
                </span>
              </li>
            ))
          }
        </ul>
        <figcaption>多市场 · 实时推送</figcaption>
      </figure>
    </div>
  </div>
</section>
