---
import ChartView from './demo/ChartView.astro';
import ResearchView from './demo/ResearchView.astro';
import TrainerView from './demo/TrainerView.astro';
import { CHAPTERS } from '../../scripts/landing/demo/timeline';
import { snapshot } from '../../scripts/landing/replica/snapshot';
import '../../styles/landing/tokens.css';
import '../../styles/landing/replica.css';
import '../../styles/landing/demo.css';

const appTabs = [
  { view: 'chart', name: 'NVDA.US 短线多周期' },
  { view: 'train', name: '盲盘训练' },
  { view: 'research', name: '研究库' },
];

const chapterCopy: Record<string, { title: string; body: string }> = {
  trace: {
    title: '它查了什么，全在这儿。',
    body: '每次分析都从取证开始。调用了哪些工具、传了什么参数、花了多久、返回了什么，全程留痕，点开就是原始记录。指标在本机实算，不是某个接口甩回来的数字。',
  },
  verdict: {
    title: '判断带着概率和触发条件。',
    body: '三档情景概率合计 100，每一档都挂着可检验的触发条件——不是「可能涨也可能跌」这种说了等于没说的话。',
  },
  archive: {
    title: '归档了，就赖不掉。',
    body: '判断一旦归档就是冻结记录。你可以追问、可以质疑、可以说它错了——它只会解释，不会偷偷改写。你盯着卡片看，它一个像素都不会动。',
  },
  score: {
    title: '它有判断，也有命中率。',
    body: '每条判断都会被结果检验，命中和落空一并记账。命中率不是宣传数字，是这些记录算出来的。',
  },
  tools: {
    title: 'AI 之下，是一套完整的本地看盘工具。',
    body: '多周期 K 线、画线工具、SEPA 仪表盘、盘面与复盘、美港 A 三市场，这些永久免费。形态是本机实算标出来的：123 结构、K 线形态、MACD 背驰，确认了打 ✓，没确认打 ?。左边工具栏可以直接画，图也能拖能缩。',
  },
  train: {
    title: '先自己看盘，再看答案。',
    body: '盲盘训练把一段真实历史盖住——不给代码、不给日期，只有走势。你逐根推进、下单、加减仓，走完才揭盲，按 R（一份风险，等于成交价到止损的距离）结算。这是 Pro 能力；下面这张图可以直接点「步进」往前走，左边的画线工具也能用。',
  },
  research: {
    title: '研究不是聊天记录。',
    body: '每只票的档案、每天的复盘和教训，都是本地 markdown 文件，你自己就能读能改。浏览和搜索免费版就有；让 AI 增量改稿、按信源刷新是 Pro 能力，它只补新事实、不覆盖你写过的判断。左边的列表可以直接点。',
  },
};
---

<section class="demo" id="demo" data-demo-scene>
  <div class="demo-sticky">
    <div class="demo-inner">
      <div class="demo-copy">
        {
          CHAPTERS.map((chapter, i) => (
            <article
              class="demo-chapter"
              data-chapter={chapter.id}
              data-active={i === 0 ? 'true' : 'false'}
            >
              <div class="demo-chapter-head">
                <span class="demo-chapter-index">
                  {String(i + 1).padStart(2, '0')} / {String(CHAPTERS.length).padStart(2, '0')} ·{' '}
                  {chapter.label}
                </span>
                <h2>{chapterCopy[chapter.id].title}</h2>
              </div>
              <p>{chapterCopy[chapter.id].body}</p>
            </article>
          ))
        }
      </div>

      <div class="app demo-app">
        <div class="app-tabbar">
          {
            appTabs.map((tab, i) => (
              <button
                type="button"
                class="app-tab-chip"
                data-app-tab={tab.view}
                data-active={i === 0 ? 'true' : 'false'}
              >
                <i />
                {tab.name}
              </button>
            ))
          }
          <span class="app-tab-add">＋</span>
          <span class="app-spacer" />
          <span class="app-tab-hint">
            真实行情快照 {snapshot.capturedAt} · {snapshot.source} · 滚动即播放
          </span>
        </div>

        <div class="app-stage">
          <ChartView />
          <TrainerView />
          <ResearchView />
        </div>
      </div>
    </div>
  </div>
</section>
