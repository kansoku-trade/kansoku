---
import CanvasView from './demo/CanvasView.astro';
import ChartView from './demo/ChartView.astro';
import ChatView from './demo/ChatView.astro';
import ResearchView from './demo/ResearchView.astro';
import TrainerView from './demo/TrainerView.astro';
import { CHAPTERS } from '../../scripts/landing/demo/timeline';
import { snapshot } from '../../scripts/landing/replica/snapshot';
import '../../styles/landing/tokens.css';
import '../../styles/landing/replica.css';
import '../../styles/landing/demo.css';

const appTabs = [
  { view: 'chart', name: 'NVDA.US 短线多周期' },
  { view: 'chat', name: 'AI 对话' },
  { view: 'canvas', name: '画布 · MU 对照' },
  { view: 'research', name: '研究库' },
  { view: 'train', name: '盲盘训练' },
];

const chapterCopy: Record<string, { title: string; body: string; pro?: string }> = {
  tools: {
    title: '打开就是你平时看盘的样子。',
    body: '多周期 K 线、画线、SEPA 趋势模板放在一个工作区里。美股、港股、A 股按各自交易时段处理，指标在本机算。',
  },
  verdict: {
    title: '让 AI 给个短线判断，附上依据。',
    body: '先列出这次分析调了哪些数据，再给上涨、整理、下跌三种情景，各带概率和触发条件。',
  },
  archive: {
    title: '写下就冻结，追问不改原判。',
    body: '判断归档后不再改写。之后的追问、新数据和修正作为新记录追加，前后都留着。',
  },
  score: {
    title: '行情走完，自动打分。',
    body: '跟踪每条判断之后的实际走势，标记命中或未中，汇总成命中率。',
  },
  chat: {
    title: '直接问，答案带着数据来。',
    body: '随手问一句，AI 去拉行情、资金流和新闻再回答。每一步调用了什么都列在回答里，可以点开看。',
  },
  canvas: {
    title: '把对话里的结论拼成一页。',
    body: '让 AI 把结论、关键数字、对照和数据边界摊到一屏上。看盘时开着，不用翻聊天记录。',
  },
  research: {
    title: '档案和教训都是本地文件。',
    pro: 'AI 改稿 · Pro',
    body: '股票档案、每日复盘和教训存成本地 Markdown，可以直接读、改、迁移。让 AI 改稿是 Pro 功能。',
  },
  train: {
    title: '用历史行情练手。',
    pro: 'Pro',
    body: '盖住代码和日期，逐根推进 K 线、画线、下单、调仓。结束后揭晓，按 R（一份风险，即入场价到初始止损的距离）结算。',
  },
};
---

<section class="demo" id="demo" data-demo-scene>
  <div class="demo-sticky">
    <div class="demo-inner">
      <div class="demo-copy">
        {
          CHAPTERS.map((chapter, i) => (
            <article
              class="demo-chapter"
              data-chapter={chapter.id}
              data-active={i === 0 ? 'true' : 'false'}
            >
              <div class="demo-chapter-head">
                <span class="demo-chapter-index">
                  {String(i + 1).padStart(2, '0')} / {String(CHAPTERS.length).padStart(2, '0')} ·{' '}
                  {chapter.label}
                </span>
                <div class="demo-chapter-title">
                  <h2>{chapterCopy[chapter.id].title}</h2>
                  {chapterCopy[chapter.id].pro && (
                    <span class="demo-pro-tag">{chapterCopy[chapter.id].pro}</span>
                  )}
                </div>
              </div>
              <p>{chapterCopy[chapter.id].body}</p>
            </article>
          ))
        }
      </div>

      <div class="app demo-app">
        <div class="app-tabbar">
          {
            appTabs.map((tab, i) => (
              <button
                type="button"
                class="app-tab-chip"
                data-app-tab={tab.view}
                data-active={i === 0 ? 'true' : 'false'}
              >
                <i />
                {tab.name}
              </button>
            ))
          }
          <span class="app-tab-add">＋</span>
          <span class="app-spacer" />
          <span class="app-tab-hint">
            行情快照：{snapshot.capturedAt} · {snapshot.source} · 向下滚动查看
          </span>
        </div>

        <div class="app-stage">
          <ChartView />
          <ChatView />
          <TrainerView />
          <ResearchView />
          <CanvasView />
        </div>
      </div>
    </div>
  </div>
</section>
