---
import { scoredJudgments } from '../../scripts/landing/scorecardData';
import { CHAPTERS } from '../../scripts/landing/demo/timeline';
import '../../styles/landing/tokens.css';
import '../../styles/landing/replica.css';
import '../../styles/landing/demo.css';

const timeframes = ['5m', '15m', '1h'];

const appTabs = [
  { name: 'Kansoku', active: false },
  { name: 'NVDA.US 短线多周期', active: true },
  { name: 'MU', active: false },
];

const sepaChecks = [
  { title: '价 > 150MA 且 > 200MA', sub: '价 $928.19 vs 150MA $874.31 / 200MA $836.08' },
  { title: '150MA > 200MA', sub: '874.31 > 836.08' },
  { title: '200MA 上行 ≥ 1 月', sub: '1 月斜率 +18.42%，4 月 +36.71%' },
  { title: '50MA > 150MA 且 > 200MA', sub: '901.55 > 874.31 > 836.08' },
  { title: '价 > 50MA', sub: '价 $928.19 vs 50MA $901.55 (+2.96%)' },
  { title: '距 52w 低 ≥ +30%', sub: '+164%（低 $351.02）' },
  { title: '距 52w 高 ≤ 25% 内', sub: '−6.18%（高 $989.34）' },
  { title: 'RS > 70 分位 (vs SPY)', sub: '21 天 +12.4 pp，126 天 +88.6 pp' },
];

const keyStats = [
  { label: '距 52w 高 $989.34', value: '−6.18%', tone: 'down' },
  { label: '距 52w 低 $351.02', value: '+164%', tone: 'up' },
  { label: '距 MA50', value: '+2.96%', tone: 'up' },
];

const tools = [
  { name: '选择', d: 'M4 2l8 8-3.4.5L11 15l-2 .9-2.3-4.4L4 14z' },
  { name: '趋势线', d: 'M2 13L7 7l3 3 4-6' },
  { name: '多段线', d: 'M2 12l4-5 3 3 3-5 2 3' },
  { name: '水平线', d: 'M2 8h12' },
  { name: '矩形', d: 'M3 4h10v8H3z' },
  { name: '斐波那契', d: 'M2 4h12 M2 7h12 M2 10h12 M2 13h12' },
];

const calls = [
  { tool: 'fetch_kline', args: 'NVDA.US · 5m · 120', dur: '184ms' },
  { tool: 'technical', args: 'MACD · 1h', dur: '96ms' },
  { tool: 'capital-flow', args: 'intraday', dur: '312ms' },
  { tool: 'quote', args: 'realtime', dur: '41ms' },
  { tool: 'finance-calendar', args: 'report · 30d', dur: '77ms' },
  { tool: 'news', args: '24h', dur: '203ms' },
];

const bars = [
  { key: 'Bull', tone: 'up' },
  { key: 'Base', tone: 'base' },
  { key: 'Bear', tone: 'down' },
];

const challenges = [
  { q: '凭什么？', a: '该判断基于 11:02 的 1h MACD 顶背驰，数据点全部可查。' },
  { q: '我觉得要涨了', a: '触发条件是跌破 236.10 且放量，没触发之前判断不变。' },
  { q: '改一下结论', a: '已归档记录不可编辑，新证据只能新开一条判断。' },
];

const chapterCopy: Record<string, { title: string; body: string }> = {
  trace: {
    title: '它查了什么，全在这儿。',
    body: '每次分析都从取证开始。调用了哪些工具、传了什么参数、花了多久、返回了什么，全程留痕，点开就是原始记录。指标在本机实算，不是某个接口甩回来的数字。',
  },
  verdict: {
    title: '判断带着概率和触发条件。',
    body: '三档情景概率合计 100，每一档都挂着可检验的触发条件——不是「可能涨也可能跌」这种说了等于没说的话。',
  },
  archive: {
    title: '归档了，就赖不掉。',
    body: '判断一旦归档就是冻结记录。你可以追问、可以质疑、可以说它错了——它只会解释，不会偷偷改写。你盯着卡片看，它一个像素都不会动。',
  },
  score: {
    title: '它有判断，也有命中率。',
    body: '每条判断都会被结果检验，命中和落空一并记账。命中率不是宣传数字，是这些记录算出来的。',
  },
  tools: {
    title: 'AI 之下，是一套完整的本地看盘工具。',
    body: '多周期 K 线、画线工具、SEPA 仪表盘、盘面与复盘、美港 A 三市场。AI 只是长在它上面的一层。',
  },
};
---

<section class="demo" data-demo-scene>
  <div class="demo-sticky">
    <div class="demo-inner">
      <div class="demo-copy">
        {
          CHAPTERS.map((chapter, i) => (
            <article class="demo-chapter" data-chapter={chapter.id} data-active={i === 0 ? 'true' : 'false'}>
              <span class="demo-chapter-index">
                {String(i + 1).padStart(2, '0')} / {String(CHAPTERS.length).padStart(2, '0')} · {chapter.label}
              </span>
              <h2>{chapterCopy[chapter.id].title}</h2>
              <p>{chapterCopy[chapter.id].body}</p>
            </article>
          ))
        }
        <div class="demo-hint">滚动即播放 · 点击章节可跳转</div>
      </div>

      <div class="app demo-app">
        <div class="app-tabbar">
          {
            appTabs.map((tab) => (
              <span class="app-tab-chip" data-active={String(tab.active)}>
                <i></i>
                {tab.name}
              </span>
            ))
          }
          <span class="app-tab-add">＋</span>
          <span class="app-spacer"></span>
          <span class="app-tab-action">新建图表</span>
        </div>
        <header class="app-titlebar">
          <span class="app-back">← 列表</span>
          <strong class="app-title">NVDA.US 短线多周期</strong>
          <div class="app-tfs" role="tablist" data-demo-tfs>
            {
              timeframes.map((tf) => (
                <button class="app-tf" type="button" role="tab" data-tf={tf} aria-selected={tf === '15m' ? 'true' : 'false'}>
                  {tf}
                </button>
              ))
            }
          </div>
          <span class="app-spacer"></span>
          <span class="app-alert">● AI 提醒 · premarket_gap</span>
          <span class="app-price">$928.19 <b>+1.86%</b></span>
        </header>

        <div class="app-body">
          <aside class="app-tools" aria-label="画线工具">
            {
              tools.map((tool, i) => (
                <button class="app-tool" type="button" title={tool.name} aria-label={tool.name} data-demo-tool data-active={i === 0 ? 'true' : 'false'}>
                  <svg viewBox="0 0 16 16" aria-hidden="true"><path d={tool.d} /></svg>
                </button>
              ))
            }
          </aside>

          <div class="app-chart">
            <div class="app-legend">
              <span class="app-chip">K 线 + 成交量</span>
              <span class="app-ema" data-replica-legend>EMA9   EMA21   EMA55</span>
              <span class="app-spacer"></span>
              <span class="app-chip app-chip-ghost">图层 4/12</span>
            </div>
            <canvas data-replica-canvas></canvas>
            <div class="app-macd-tag">MACD (12,26,9)</div>
          </div>

          <aside class="app-panel demo-panel">
            <div class="demo-view" data-panel-view="trace" data-active="true">
              <div class="demo-view-head">
                <span>TOOL CALL TRACE</span>
                <span data-trace-meta>0 / 6 calls</span>
              </div>
              <ol class="demo-trace">
                {
                  calls.map((call) => (
                    <li class="demo-trace-row" data-trace-row data-on="false">
                      <i></i>
                      <span class="demo-trace-tool">{call.tool}</span>
                      <span class="demo-trace-args">{call.args}</span>
                      <span class="demo-trace-dur">{call.dur}</span>
                    </li>
                  ))
                }
              </ol>
            </div>

            <div class="demo-view" data-panel-view="verdict" data-active="false">
              <div class="demo-verdict" data-demo-verdict data-on="false">
                <div class="demo-verdict-head">
                  <span class="demo-verdict-sym">NVDA.US</span>
                  <span class="demo-stamp" data-demo-stamp data-on="false">ARCHIVED · 冻结</span>
                </div>
                <div class="demo-verdict-dir">偏空</div>
                {
                  bars.map((bar) => (
                    <div class="demo-bar-row">
                      <span>{bar.key}</span>
                      <div class="demo-bar-track">
                        <i data-demo-bar data-tone={bar.tone}></i>
                      </div>
                      <span data-demo-value>0%</span>
                    </div>
                  ))
                }
                <div class="demo-verdict-trig">触发：跌破 236.10 且放量</div>
              </div>
              <ol class="demo-challenges">
                {
                  challenges.map((item) => (
                    <li data-demo-challenge data-on="false">
                      <span class="demo-q">{item.q}</span>
                      <span class="demo-a">{item.a}</span>
                    </li>
                  ))
                }
              </ol>
            </div>

            <div class="demo-view" data-panel-view="score" data-active="false">
              <div class="demo-view-head">
                <span>SCORECARD</span>
                <span>命中率 <b data-demo-rate>0%</b></span>
              </div>
              <ol class="demo-score">
                {
                  scoredJudgments.map((record) => (
                    <li data-demo-score-row data-outcome={record.outcome} data-on="false">
                      <span class="demo-score-sym">{record.symbol}</span>
                      <span class="demo-score-date">{record.date}</span>
                      <span class="demo-score-call">{record.call}</span>
                      <span class="demo-score-mark">{record.outcome === 'hit' ? '✓' : '✗'}</span>
                    </li>
                  ))
                }
              </ol>
            </div>

            <div class="demo-view" data-panel-view="tools" data-active="false">
              <div class="demo-sepa-verdict">
                <span class="demo-sepa-label">SEPA 结论</span>
                <strong>👀 WATCH LIST</strong>
                <p>
                  8 条全过，自动检测未发现可买的整理形态（VCP / 杯柄 / 平台 / 旗形需人工目视确认）。若价位在
                  pivot ~ pivot+5% 买入区且当日成交量 ≥ 1.5×20MA 量，则可升为 Strong Buy。
                </p>
              </div>
              <div class="demo-view-head"><span>趋势模板 8 条</span><span>8 / 8</span></div>
              <ol class="demo-sepa">
                {
                  sepaChecks.map((check) => (
                    <li>
                      <i>✓</i>
                      <span>
                        <b>{check.title}</b>
                        <em>{check.sub}</em>
                      </span>
                    </li>
                  ))
                }
              </ol>
              <div class="demo-view-head"><span>关键数值</span></div>
              <ul class="demo-keystats">
                {
                  keyStats.map((stat) => (
                    <li>
                      <span>{stat.label}</span>
                      <b data-tone={stat.tone}>{stat.value}</b>
                    </li>
                  ))
                }
              </ul>
            </div>
          </aside>
        </div>

        <footer class="demo-scrub">
          <div class="demo-scrub-track" data-scrub-track>
            <div class="demo-scrub-head" data-scrub-head></div>
          </div>
          <div class="demo-scrub-markers" data-scrub-markers>
            {
              CHAPTERS.map((chapter, i) => (
                <button type="button" data-scrub-marker data-active={i === 0 ? 'true' : 'false'}>
                  {chapter.label}
                </button>
              ))
            }
          </div>
          <span class="demo-scrub-clock" data-scrub-clock>0.0s</span>
        </footer>
      </div>
    </div>
  </div>
</section>
