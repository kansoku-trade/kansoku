---
import CanvasView from './demo/CanvasView.astro';
import ChartView from './demo/ChartView.astro';
import ResearchView from './demo/ResearchView.astro';
import TrainerView from './demo/TrainerView.astro';
import { CHAPTERS } from '../../scripts/landing/demo/timeline';
import { snapshot } from '../../scripts/landing/replica/snapshot';
import '../../styles/landing/tokens.css';
import '../../styles/landing/replica.css';
import '../../styles/landing/demo.css';

const appTabs = [
  { view: 'chart', name: 'NVDA.US 短线多周期' },
  { view: 'train', name: '盲盘训练' },
  { view: 'research', name: '研究库' },
  { view: 'canvas', name: '画布 · MU 对照' },
];

const chapterCopy: Record<string, { title: string; body: string; pro?: boolean }> = {
  trace: {
    title: '从数据开始。',
    body: '打开一条分析，可以看到本次查询使用的数据、时间和返回结果。均线、MACD 等指标由本机计算，复盘时仍可回到原始记录。',
  },
  verdict: {
    title: '把判断写清楚。',
    body: '上涨、整理和下跌三种情景分别记录概率与触发条件。行情走到哪一步，之后可以按原条件复查。',
  },
  archive: {
    title: '保留判断当时的版本。',
    body: '记录归档后不再改写。新的问题、数据和修正继续追加，前后变化都留得下来。',
  },
  score: {
    title: '让结果回到记录里。',
    body: '系统跟踪判断后的实际走势，标记命中或未中，并汇总历史结果。',
  },
  tools: {
    title: '日常看盘所需的工具，都在这里。',
    body: '多周期 K 线、画线、SEPA、盘中记录和历史复盘都在同一个工作区。美股、港股和 A 股按各自交易时段处理；形态与指标由本机计算。',
  },
  train: {
    title: '隐藏答案，重新走一遍历史行情。',
    pro: true,
    body: '盲盘训练隐藏股票代码和日期。你可以逐根推进 K 线、画线、下单和调整仓位，结束后再揭晓原始行情并查看结果；右侧演示可以直接操作。',
  },
  research: {
    title: '研究资料留在文件里。',
    pro: true,
    body: '股票档案、每日复盘和教训保存在本地 Markdown 文件中，可以直接阅读、修改和迁移。需要时，再让 AI 补充资料或整理改动。',
  },
  canvas: {
    title: '数字本身就是交付物。',
    body: '对话里拼出一张分析板：结论、关键数字、对照和数据边界摊在同一屏。免费最多 3 张，覆盖已有的那张不受限；Pro 不限数量。右侧演示可以点开另外一张。',
  },
};
---

<section class="demo" id="demo" data-demo-scene>
  <div class="demo-sticky">
    <div class="demo-inner">
      <div class="demo-copy">
        {
          CHAPTERS.map((chapter, i) => (
            <article
              class="demo-chapter"
              data-chapter={chapter.id}
              data-active={i === 0 ? 'true' : 'false'}
            >
              <div class="demo-chapter-head">
                <span class="demo-chapter-index">
                  {String(i + 1).padStart(2, '0')} / {String(CHAPTERS.length).padStart(2, '0')} ·{' '}
                  {chapter.label}
                </span>
                <div class="demo-chapter-title">
                  <h2>{chapterCopy[chapter.id].title}</h2>
                  {chapterCopy[chapter.id].pro && <span class="demo-pro-tag">Pro</span>}
                </div>
              </div>
              <p>{chapterCopy[chapter.id].body}</p>
            </article>
          ))
        }
      </div>

      <div class="app demo-app">
        <div class="app-tabbar">
          {
            appTabs.map((tab, i) => (
              <button
                type="button"
                class="app-tab-chip"
                data-app-tab={tab.view}
                data-active={i === 0 ? 'true' : 'false'}
              >
                <i />
                {tab.name}
              </button>
            ))
          }
          <span class="app-tab-add">＋</span>
          <span class="app-spacer" />
          <span class="app-tab-hint">
            行情快照：{snapshot.capturedAt} · {snapshot.source} · 向下滚动查看
          </span>
        </div>

        <div class="app-stage">
          <ChartView />
          <TrainerView />
          <ResearchView />
          <CanvasView />
        </div>
      </div>
    </div>
  </div>
</section>
