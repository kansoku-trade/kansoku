---
import '../../styles/landing/tokens.css';
import '../../styles/landing/reveal.css';
import '../../styles/landing/pillars.css';
import '../../styles/landing/sourced.css';

interface ToolCall {
  tool: string;
  args: string;
  time: string;
  duration: string;
  rows: string;
  detail?: { request: string; response: string };
}

const calls: ToolCall[] = [
  {
    tool: 'fetch_kline',
    args: 'NVDA.US · 5m · 120',
    time: '09:31:02',
    duration: '184ms',
    rows: '120 bars',
  },
  {
    tool: 'technical',
    args: 'NVDA.US · MACD · 1h',
    time: '09:31:03',
    duration: '96ms',
    rows: '1 signal',
    detail: {
      request: 'symbol: NVDA.US · window: 1h · indicator: MACD(12,26,9)',
      response: '底背驰 · DIF −0.42 → −0.31 · DEA −0.51 · 柱状转正 · 本机实算',
    },
  },
  {
    tool: 'capital-flow',
    args: 'NVDA.US · intraday',
    time: '09:31:05',
    duration: '312ms',
    rows: '241 ticks',
  },
  {
    tool: 'quote',
    args: 'NVDA.US · realtime',
    time: '09:31:05',
    duration: '41ms',
    rows: '1 quote',
  },
  {
    tool: 'finance-calendar',
    args: 'report · 30d',
    time: '09:31:08',
    duration: '77ms',
    rows: '3 events',
  },
  {
    tool: 'news',
    args: 'NVDA.US · 24h',
    time: '09:31:10',
    duration: '203ms',
    rows: '3 items',
  },
];
---

<section class="sourced">
  <div class="sourced-copy">
    <h2>它查了什么，全在这儿。</h2>
    <ul class="sourced-points">
      <li>工具调用全程留痕，点开就是它查了什么、什么时候查的、返回了什么。</li>
      <li>均线、MACD、RS、趋势模板、背离全部在本机实算，不是某个接口甩回来的数字。</li>
      <li>追问时它先读你画的线，再结合实时行情回答。</li>
    </ul>
  </div>

  <div class="sourced-scene" data-sourced-scene data-reveal>
    <div class="tl-head">
      <span>TOOL CALL TRACE</span>
      <span class="tl-head-meta">6 calls · 913ms</span>
    </div>
    <ol class="tl-track" data-tl-track>
      {
        calls.map((call) => (
          <li class="tl-cell" data-tl-cell>
            <div class="tl-row">
              <i class="tl-dot"></i>
              <span class="tl-tool">{call.tool}</span>
              <span class="tl-args">{call.args}</span>
              <span class="tl-spacer" />
              <span class="tl-rows">{call.rows}</span>
              <span class="tl-time">{call.time}</span>
              <span class="tl-dur">{call.duration}</span>
            </div>
            {call.detail && (
              <div class="tl-detail" data-tl-detail>
                <div class="tl-detail-inner">
                  <p>
                    <b>请求</b>
                    <span>{call.detail.request}</span>
                  </p>
                  <p>
                    <b>返回</b>
                    <span>{call.detail.response}</span>
                  </p>
                </div>
              </div>
            )}
          </li>
        ))
      }
    </ol>
    <div class="tl-foot">全部调用与返回原样保存在本地，可回溯、可导出</div>
  </div>
</section>
